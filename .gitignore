# Installed dependencies and generated files (recreated after cloning).
node_modules/
public/
.cache/
.firebase/
.wrangler/
.emulator-data/
backups/

# Logs and Python environments are specific to each machine.
# A .venv only works on the machine (and Python version) that created it.
.venv/
venv/
*.log
__pycache__/
*.py[cod]

# Keep the shareable template; never commit credentials or account passwords.

.env.*
!.env.example

*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12
*.pfx

# Keep model weights in Git; ignore interrupted downloads.
hardware/models/*.download

# Editor and OS files.
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
