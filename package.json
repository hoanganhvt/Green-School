{
  "name": "green-school",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup:sim": "py -3.12 -m venv .venv",
    "setup:camera": "npm run setup:sim && .venv\\Scripts\\python.exe -m pip install -r hardware/requirements-camera.txt && .venv\\Scripts\\python.exe hardware/download_camera_model.py",
    "backend": "node --env-file-if-exists=.env backend/index.cjs",
    "emulators": "node scripts/emulators.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:emulators": "node scripts/emulators.cjs test",
    "simulate:esp": "node scripts/simulate-esp.cjs",
    "seed:emulators": "node scripts/seed-emulators.cjs"
  },
  "engines": { "node": ">=22.9.0" },
  "dependencies": { "firebase-admin": "^13.0.0" },
  "devDependencies": { "firebase-tools": "15.34.0" }
}
